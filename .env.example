# Copy to .env and replace placeholders. Environment variables take precedence.
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token
TELEGRAM_ALLOWED_USER_IDS=123456789
# macOS app to start if stopped; leave blank for remote/daemon-only Transmission.
TRANSMISSION_APP_PATH=/Applications/Transmission.app
TRANSMISSION_RPC_URL=http://127.0.0.1:9091/transmission/rpc
# Optional; set both together when RPC authentication is enabled.
TRANSMISSION_USERNAME=
TRANSMISSION_PASSWORD=
# Optional; blank uses Transmission's own default directory.
TRANSMISSION_DOWNLOAD_DIR=
DATABASE_PATH=.runtime/bot.db
LOG_LEVEL=INFO
LOG_FILE=.runtime/bot.log
# Maximum size per log file, and number of rotated backups.
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
